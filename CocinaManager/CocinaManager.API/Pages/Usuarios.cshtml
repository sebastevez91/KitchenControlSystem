@page
@model CocinaManager.API.Pages.UsuariosModel
@using CocinaManager.Domain.Enums
@{
    ViewData["Title"] = "Panel de Usuarios";
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="stat-card text-white" style="background: linear-gradient(135deg, #0d6efd, #000); width: stretch;">
        <div>
            <h1><i class="bi bi-people me-2"></i>Panel de Usuarios</h1>
            <p class="mb-0">Gestión de accesos al sistema</p>
        </div>
        <div class="d-flex gap-2" style="justify-content: flex-end;">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoUsuario">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Usuario
            </button>
        </div>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-person-badge me-2"></i>Usuarios del sistema</span>
        <span class="badge bg-primary">@Model.Usuarios.Count usuarios</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Usuarios)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle avatar-sm">
                                    @u.NombreUsuario[..Math.Min(2, u.NombreUsuario.Length)].ToUpper()
                                </div>
                                <div>
                                    <div class="fw-semibold">@u.NombreUsuario</div>
                                    <div class="text-muted small">@((u.Nombre != null || u.Apellido != null) ? $"{u.Nombre} {u.Apellido}".Trim() : "<sin nombre>")</div>
                                </div>
                                @if (u.NombreUsuario == User.Identity?.Name)
                                {
                                    <span class="badge bg-secondary" style="font-size:0.7rem;">Tú</span>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="badge px-3"
                                  style="background-color:@(u.Rol == RolUsuario.Admin ? "#764ba2" : "#6c757d");">
                                @u.Rol
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-success badge-estado">Activo</span>
                        </td>
                        <td>
                            @if (u.NombreUsuario != User.Identity?.Name)
                            {
                                <form method="post" asp-page-handler="Eliminar"
                                      onsubmit="return confirm('¿Eliminar usuario @u.NombreUsuario?')">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nuevo Usuario -->
<div class="modal fade" id="modalNuevoUsuario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Nuevo Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Crear">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre de usuario</label>
                        <input name="NombreUsuario" class="form-control"
                               placeholder="Ej: jperez" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contraseña</label>
                        <input name="Password" type="password" class="form-control"
                               placeholder="Mínimo 6 caracteres" />
                    </div>

                    <!-- Nuevos campos Nombre y Apellido -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre (opcional)</label>
                        <input name="Nombre" class="form-control" placeholder="Ej: Juan" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Apellido (opcional)</label>
                        <input name="Apellido" class="form-control" placeholder="Ej: Pérez" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rol</label>
                        <select name="Rol" class="form-select">
                            <option value="1">Admin</option>
                            <option value="2" selected>Operario</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear Usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>