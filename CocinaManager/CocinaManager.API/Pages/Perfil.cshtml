@page
@model CocinaManager.API.Pages.PerfilModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="page-header">
    <h1><i class="bi bi-person-circle me-2"></i>Mi Perfil</h1>
    <p class="text-muted mb-0">Información de tu cuenta</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body py-4">
                <!-- Avatar grande -->
                <div class="avatar-circle mx-auto mb-3"
                     style="width:80px; height:80px; font-size:1.8rem;">
                    @Model.NombreUsuario[..Math.Min(2, Model.NombreUsuario.Length)].ToUpper()
                </div>
                <h4 class="fw-bold mb-1">@Model.NombreUsuario</h4>
                <span class="badge px-3 py-2"
                      style="background-color:@(Model.Rol == "Administrador" ? "#764ba2" : "#6c757d"); font-size:0.85rem;">
                    @Model.Rol
                </span>
                <hr />
                <div class="row g-3 text-center">
                    <div class="col-6">
                        <div class="fw-bold fs-4 text-primary">@Model.TurnosHoy</div>
                        <div class="text-muted small">Turnos hoy</div>
                    </div>
                    <div class="col-6">
                        <div class="fw-bold fs-4 text-primary">@Model.TotalTurnos</div>
                        <div class="text-muted small">Turnos totales</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle me-2"></i>Información de la cuenta
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted fw-semibold" style="width:160px;">
                                <i class="bi bi-person me-2"></i>Usuario
                            </td>
                            <td class="fw-semibold">@Model.NombreUsuario</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">
                                <i class="bi bi-shield me-2"></i>Rol
                            </td>
                            <td>
                                <span class="badge px-3"
                                      style="background-color:@(Model.Rol == "Administrador" ? "#764ba2" : "#6c757d");">
                                    @Model.Rol
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">
                                <i class="bi bi-calendar me-2"></i>Fecha
                            </td>
                            <td>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold">
                                <i class="bi bi-circle-fill me-2 text-success" style="font-size:0.6rem;"></i>Estado
                            </td>
                            <td class="text-success fw-semibold">Sesión activa</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>