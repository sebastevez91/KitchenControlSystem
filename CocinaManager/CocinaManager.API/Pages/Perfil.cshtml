@page
@model CocinaManager.API.Pages.PerfilModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="stat-card text-white" style="background: linear-gradient(135deg, #0d6efd, #000); width: stretch;">
        <h1><i class="bi bi-person-circle me-2"></i>Mi Perfil</h1>
        <p class="mb-0">Actualizá tu nombre y apellido</p>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <!-- Nombre -->
        <div class="mb-3 d-flex justify-content-between align-items-center">
            <div>
                <label class="form-label fw-semibold mb-1">Nombre</label>
                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.Nombre) ? Model.Nombre : "<sin nombre>")</div>
            </div>
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalEditarNombre">Editar</button>
        </div>

        <!-- Apellido -->
        <div class="mb-3 d-flex justify-content-between align-items-center">
            <div>
                <label class="form-label fw-semibold mb-1">Apellido</label>
                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.Apellido) ? Model.Apellido : "<sin apellido>")</div>
            </div>
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalEditarApellido">Editar</button>
        </div>
    </div>
</div>

<!-- Modal Editar Nombre -->
<div class="modal fade" id="modalEditarNombre" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Nombre</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="GuardarNombre">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre</label>
                        <input asp-for="Nombre" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Apellido -->
<div class="modal fade" id="modalEditarApellido" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Apellido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="GuardarApellido">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Apellido</label>
                        <input asp-for="Apellido" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>