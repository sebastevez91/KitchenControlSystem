@page
@model CocinaManager.API.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes";
}
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="stat-card text-white" style="background: linear-gradient(135deg, #0d6efd, #000); width: stretch;">
        <div>
            <h1><i class="bi bi-box-seam-fill me-2"></i>Reportes</h1>
            <p class=" mb-0">Gestión de reportes de base de datos</p>
        </div>
    </div>
</div>
<div class="mb-3">
    <a class="btn btn-outline-primary me-2" href="/api/reportes/personal">Descargar Personal (Excel)</a>
    <a class="btn btn-outline-primary me-2" href="/api/reportes/turnos">Descargar Turnos (Excel)</a>
    <a class="btn btn-outline-primary me-2" href="/api/reportes/productos-stock">Descargar Productos/Stock (Excel)</a>
    <a class="btn btn-outline-primary me-2" href="/api/reportes/movimientos-stock">Descargar Movimientos (Excel)</a>
</div>

<div class="card mb-3">
    <div class="card-body d-flex align-items-center gap-2">
        <label class="mb-0 fw-semibold">Seleccionar mes:</label>
        <input id="mesPicker" type="month" class="form-control form-control-sm" style="width:180px;" />
        <button id="btnPdf" class="btn btn-primary btn-sm">Descargar Turnos (PDF)</button>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('btnPdf').addEventListener('click', function () {
        const val = document.getElementById('mesPicker').value;
        if (!val) { alert('Seleccioná un mes'); return; }
        const [year, month] = val.split('-');
        const url = `/api/reportes/turnos-mes?year=${year}&month=${parseInt(month)}`;
        window.location.href = url;
    });
</script>
}
