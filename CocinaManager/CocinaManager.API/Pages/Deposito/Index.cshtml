@page
@model CocinaManager.API.Pages.Deposito.IndexModel
@{
    ViewData["Title"] = "Depósito";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-box-seam-fill me-2"></i>Depósito</h1>
        <p class="text-muted mb-0">Control de stock y movimientos de víveres</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalMovimiento">
            <i class="bi bi-arrow-left-right me-1"></i> Registrar Movimiento
        </button>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoProducto">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
        </button>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Alerta stock bajo -->
@if (Model.ProductosStockBajo.Any())
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>
            <strong>⚠️ Stock bajo:</strong>
            @string.Join(", ", Model.ProductosStockBajo.Select(p => $"{p.Nombre} ({p.StockActual} {p.UnidadMedida})"))
        </div>
    </div>
}

<!-- Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card" style="background: linear-gradient(135deg, #11998e, #38ef7d);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size:2rem; font-weight:700;">@Model.Productos.Count</div>
                    <div style="opacity:0.85;">Productos registrados</div>
                </div>
                <i class="bi bi-box-seam" style="font-size:2.5rem; opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background: linear-gradient(135deg, #f7971e, #ffd200);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size:2rem; font-weight:700;">@Model.ProductosStockBajo.Count</div>
                    <div style="opacity:0.85;">Con stock bajo</div>
                </div>
                <i class="bi bi-exclamation-triangle" style="font-size:2.5rem; opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size:2rem; font-weight:700;">@Model.Movimientos.Count</div>
                    <div style="opacity:0.85;">Movimientos totales</div>
                </div>
                <i class="bi bi-arrow-left-right" style="font-size:2.5rem; opacity:0.4;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Tabla Productos -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-ul me-2"></i>Productos en stock</span>
        <span class="badge bg-primary">@Model.Productos.Count productos</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Unidad</th>
                        <th>Stock Actual</th>
                        <th>Stock Mínimo</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Productos)
                    {
                        <tr>
                            <td class="fw-semibold">@p.Nombre</td>
                            <td>@p.UnidadMedida</td>
                            <td>@p.StockActual</td>
                            <td>@p.StockMinimo</td>
                            <td>
                                @if (p.StockActual <= p.StockMinimo)
                                {
                                    <span class="badge bg-danger badge-estado">Stock bajo</span>
                                }
                                else
                                {
                                    <span class="badge bg-success badge-estado">OK</span>
                                }
                            </td>
                            <td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form method="post" asp-page-handler="EliminarProducto"
                                          onsubmit="return confirm('¿Eliminar @p.Nombre?')">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Tabla Movimientos -->
<div class="card">
    <div class="card-header">
        <i class="bi bi-clock-history me-2"></i>Historial de movimientos
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Fecha</th>
                        <th>Observación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Movimientos.OrderByDescending(x => x.Fecha))
                    {
                        <tr>
                            <td class="fw-semibold">@m.NombreProducto</td>
                            <td>
                                @if (m.TipoMovimiento == TipoMovimiento.Entrada)
                                {
                                    <span class="badge bg-success badge-estado">
                                        <i class="bi bi-arrow-down-circle me-1"></i>Entrada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark badge-estado">
                                        <i class="bi bi-arrow-up-circle me-1"></i>Salida
                                    </span>
                                }
                            </td>
                            <td>@m.Cantidad @m.NombreProducto</td>
                            <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-muted">@m.Observacion</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nuevo Producto -->
<div class="modal fade" id="modalNuevoProducto" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-box-seam me-2"></i>Nuevo Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CrearProducto">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre</label>
                        <input asp-for="NuevoProducto.Nombre" class="form-control" placeholder="Ej: Arroz" />
                        <span asp-validation-for="NuevoProducto.Nombre" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Unidad de medida</label>
                        <input asp-for="NuevoProducto.UnidadMedida" class="form-control" placeholder="Ej: kg, litros, unidades" />
                        <span asp-validation-for="NuevoProducto.UnidadMedida" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Stock mínimo</label>
                        <input asp-for="NuevoProducto.StockMinimo" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="NuevoProducto.StockMinimo" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Registrar Movimiento -->
<div class="modal fade" id="modalMovimiento" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-arrow-left-right me-2"></i>Registrar Movimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="RegistrarMovimiento">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Producto</label>
                        <select asp-for="NuevoMovimiento.ProductoId" class="form-select">
                            <option value="">-- Seleccioná un producto --</option>
                            @foreach (var p in Model.Productos)
                            {
                                <option value="@p.Id">@p.Nombre (@p.StockActual @p.UnidadMedida)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de movimiento</label>
                        <select asp-for="NuevoMovimiento.TipoMovimiento" class="form-select">
                            @foreach (var t in Enum.GetValues<TipoMovimiento>())
                            {
                                <option value="@((int)t)">@t</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cantidad</label>
                        <input asp-for="NuevoMovimiento.Cantidad" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Observación <span class="text-muted fw-normal">(opcional)</span></label>
                        <input asp-for="NuevoMovimiento.Observacion" class="form-control" placeholder="Ej: Compra semanal" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Registrar</button>
                </div>
            </form>
        </div>
    </div>
</div>