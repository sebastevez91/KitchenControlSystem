@page
@model CocinaManager.API.Pages.CalendarioModel
@{
    ViewData["Title"] = "Calendario de Turnos";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-calendar3 me-2"></i>Calendario de Turnos</h1>
        <p class="text-muted mb-0">Vista mensual — hacé click en un día para asignar turno</p>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Leyenda -->
<div class="d-flex gap-3 mb-3 flex-wrap">
    <span class="d-flex align-items-center gap-2">
        <span style="width:14px;height:14px;border-radius:3px;background:#f7971e;display:inline-block;"></span>
        <small class="text-muted">Mañana</small>
    </span>
    <span class="d-flex align-items-center gap-2">
        <span style="width:14px;height:14px;border-radius:3px;background:#4facfe;display:inline-block;"></span>
        <small class="text-muted">Tarde</small>
    </span>
    <span class="d-flex align-items-center gap-2">
        <span style="width:14px;height:14px;border-radius:3px;background:#1a1a2e;display:inline-block;"></span>
        <small class="text-muted">Noche</small>
    </span>
</div>

<!-- Calendario -->
<div class="card">
    <div class="card-body">
        <div id="calendario"></div>
    </div>
</div>

<!-- Modal asignar turno -->
<div class="modal fade" id="modalAsignarTurno" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-calendar-plus me-2"></i>
                    Asignar Turno — <span id="fechaSeleccionada"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CrearTurno">
                <div class="modal-body">
                    <input type="hidden" id="inputFecha" name="NuevoTurno.Fecha" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Personal</label>
                        <select name="NuevoTurno.PersonalId" class="form-select">
                            <option value="">-- Seleccioná --</option>
                            @foreach (var p in Model.Personal)
                            {
                                <option value="@p.Id">@p.Nombre — @p.Cargo</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de turno</label>
                        <select name="NuevoTurno.TipoTurno" class="form-select">
                            <option value="1">🌅 Mañana</option>
                            <option value="2">☀️ Tarde</option>
                            <option value="3">🌙 Noche</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    @if (User.IsInRole("Admin"))
                    {
                        <button type="submit" class="btn btn-primary">Asignar Turno</button>
                    }
                    else
                    {
                        <span class="text-muted small">Solo Admin puede asignar turnos</span>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- FullCalendar -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/locales/es.global.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const calEl = document.getElementById('calendario');
            const isAdmin = @User.IsInRole("Admin").ToString().ToLower();

            const calendar = new FullCalendar.Calendar(calEl, {
                locale: 'es',
                initialView: 'dayGridMonth',
                height: 650,
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth'
                },
                buttonText: { today: 'Hoy' },
                events: function (info, successCallback, failureCallback) {
                    fetch(`/api/calendario/turnos?start=${info.startStr}&end=${info.endStr}`)
                        .then(r => r.json())
                        .then(data => successCallback(data))
                        .catch(() => failureCallback());
                },
                dateClick: function (info) {
                    if (!isAdmin) return;

                    const fecha = info.dateStr;
                    const fechaFormateada = new Date(fecha + 'T00:00:00')
                        .toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long' });

                    document.getElementById('fechaSeleccionada').textContent = fechaFormateada;
                    document.getElementById('inputFecha').value = fecha;

                    const modal = new bootstrap.Modal(document.getElementById('modalAsignarTurno'));
                    modal.show();
                },
                eventClick: function (info) {
                    const p = info.event.extendedProps;
                    alert(`👤 ${p.nombrePersonal}\n🕐 Turno: ${p.tipoTurno}\n📅 ${info.event.startStr}`);
                },
                eventDidMount: function (info) {
                    info.el.style.cursor = 'pointer';
                    info.el.title = info.event.title;
                },
                dayMaxEvents: 3,
                moreLinkText: 'más'
            });

            calendar.render();
        });
    </script>
}