@page
@model CocinaManager.API.Pages.Movimientos.IndexModel
@using CocinaManager.Domain.Enums
@{
    ViewData["Title"] = "Movimientos";
}
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="stat-card text-white" style="background: linear-gradient(135deg, #0d6efd, #000); width: stretch;">
        <div>
            <h1><i class="bi bi-box-seam-fill me-2"></i>Movimientos</h1>
            <p class=" mb-0">Control de movimientos de productos</p>
        </div>
        <div class="d-flex gap-2" style="justify-content: flex-end;">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalMovimiento">
                <i class="bi bi-arrow-left-right me-1"></i> Registrar Movimiento
            </button>
            <a class="btn btn-primary" href="/Recepciones/Index">
                <i class="bi bi-box-seam me-1"></i> Recepción
            </a>
        </div>
    </div>
</div>
<div class="d-flex align-items-center gap-2 mb-3">
    <form method="get" class="d-flex align-items-center gap-2">
        <label class="mb-0 fw-semibold">Fecha</label>
        <input name="Fecha" type="date" class="form-control form-control-sm" value="@(Model.Fecha.ToString("yyyy-MM-dd"))" />
        <label class="mb-0 fw-semibold ms-2">Filtrar por tipo</label>
        <select name="FiltroTipo" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
            <option value="Todos" selected="@(Model.FiltroTipo == "Todos" || string.IsNullOrEmpty(Model.FiltroTipo) ? "selected" : null)">Todos</option>
            @foreach (var t in Enum.GetValues<TipoMovimiento>())
            {
                var selected = Model.FiltroTipo == t.ToString() ? "selected" : "";
                <option value="@t" selected="@selected">@t</option>
            }
        </select>
        <noscript>
            <button type="submit" class="btn btn-sm btn-outline-primary">Aplicar</button>
        </noscript>
        <a class="btn btn-sm btn-outline-secondary ms-2" href="?Fecha=@DateTime.Today.ToString("yyyy-MM-dd")&FiltroTipo=@Model.FiltroTipo">Hoy</a>
    </form>
    <div class="ms-auto">
        <!-- botón u otros controles -->
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-info">@TempData["Mensaje"]</div>
}

<!-- Resto de la vista: tabla de movimientos -->
<div class="card">
    <div class="card-header">
        <i class="bi bi-clock-history me-2"></i>Historial de movimientos
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Fecha</th>
                        <th>Observación</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Movimientos.OrderByDescending(x => x.Fecha))
                    {
                        if(m.Id != null)
                        {
                            <tr>
                                <td><input type="checkbox" class="form-checkbox" /></td>
                                <td class="fw-semibold">@m.NombreProducto</td>
                                <td>
                                    @if (m.TipoMovimiento == TipoMovimiento.Entrada)
                                    {
                                        <span class="badge bg-success badge-estado">
                                            <i class="bi bi-arrow-down-circle me-1"></i>Entrada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark badge-estado">
                                            <i class="bi bi-arrow-up-circle me-1"></i>Salida
                                        </span>
                                    }
                                </td>
                                <td>@m.Cantidad</td>
                                <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-muted">@m.Observacion</td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@m.Id" onsubmit="return confirm('¿Deshacer este movimiento?');" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Deshacer</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                            <p>No hay registros de movimientos hoy</p>
                            </tr>

                        }

                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Registrar Movimiento -->
<div class="modal fade" id="modalMovimiento" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-arrow-left-right me-2"></i>Registrar Movimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="RegistrarMovimiento">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Fecha del movimiento</label>
                        <input asp-for="NuevoMovimiento.Fecha" type="datetime-local" class="form-control" value="@DateTime.UtcNow" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Producto</label>
                        <select asp-for="NuevoMovimiento.ProductoId" class="form-select">
                            <option value="">-- Seleccioná un producto --</option>
                            @foreach (var p in Model.Productos)
                            {
                                <option value="@p.Id">@p.Nombre (@p.StockActual @p.UnidadMedida)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de movimiento</label>
                        <select asp-for="NuevoMovimiento.TipoMovimiento" class="form-select">
                            @foreach (var t in Enum.GetValues<TipoMovimiento>())
                            {
                                <option value="@((int)t)">@t</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cantidad</label>
                        <input asp-for="NuevoMovimiento.Cantidad" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Observación <span class="text-muted fw-normal">(opcional)</span></label>
                        <input asp-for="NuevoMovimiento.Observacion" class="form-control" placeholder="Ej: Compra semanal" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Registrar</button>
                </div>
            </form>
        </div>
    </div>
</div>