@page
@model CocinaManager.API.Pages.Recetas.IndexModel
@{
    ViewData["Title"] = "Recetas";
}

<h2 class="mb-3"><i class="bi bi-journal-text"></i> Recetas</h2>

<form id="antiforgeryForm" method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>

<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
    <form method="get" class="d-flex gap-2 flex-grow-1" style="max-width: 500px;">
        <input type="text" name="Busqueda" value="@Model.Busqueda" class="form-control"
               placeholder="Buscar receta por nombre..." />
        <div class="form-check align-self-center ms-2">
            <input class="form-check-input" type="checkbox" name="MostrarInactivas" value="true"
                   id="chkInactivas" @(Model.MostrarInactivas ? "checked" : "") onchange="this.form.submit()" />
            <label class="form-check-label" for="chkInactivas">Mostrar inactivas</label>
        </div>
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    </form>

    @if (Model.EsAdmin)
    {
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalReceta"
                onclick="abrirModalCrear()">
            <i class="bi bi-plus-lg"></i> Nueva receta
        </button>
    }
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Ingredientes (dosis por persona)</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Recetas.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No se encontraron recetas.</td></tr>
            }
            @foreach (var r in Model.Recetas)
            {
                <tr class="@(r.Activo ? "" : "table-secondary")">
                    <td class="fw-semibold">@r.Nombre</td>
                    <td>@r.Descripcion</td>
                    <td>
                        <small class="text-muted">
                            @string.Join(" · ", r.Ingredientes.Select(i => $"{i.Nombre}: {i.Cantidad} {i.UnidadMedida}"))
                        </small>
                    </td>
                    <td>
                        @if (r.Activo)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactiva</span>
                        }
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" title="Editar"
                                onclick='abrirModalEditar("@r.Id")'>
                            <i class="bi bi-pencil"></i>
                        </button>
                        @if (Model.EsAdmin)
                        {
                            <button class="btn btn-sm @(r.Activo ? "btn-outline-danger" : "btn-outline-success")"
                                    title="@(r.Activo ? "Desactivar" : "Activar")"
                                    onclick='toggleActivo("@r.Id")'>
                                <i class="bi @(r.Activo ? "bi-x-circle" : "bi-check-circle")"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Crear/Editar -->
<div class="modal fade" id="modalReceta" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalReceta">Nueva receta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="recetaId" />
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text" id="recetaNombre" class="form-control" maxlength="150" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea id="recetaDescripcion" class="form-control" maxlength="1000" rows="2"></textarea>
                </div>

                <label class="form-label d-flex justify-content-between align-items-center">
                    <span>Ingredientes <small class="text-muted">(dosis por persona)</small></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="agregarFilaIngrediente()">
                        <i class="bi bi-plus-lg"></i> Agregar ingrediente
                    </button>
                </label>
                <table class="table table-sm">
                    <thead>
                        <tr><th>Ingrediente</th><th style="width:120px">Cantidad</th><th style="width:140px">Unidad</th><th></th></tr>
                    </thead>
                    <tbody id="tablaIngredientes"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarReceta()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rowTemplate = (nombre = '', cantidad = '', unidad = '') => `
            <tr>
                <td><input type="text" class="form-control form-control-sm ing-nombre" value="${nombre}" required /></td>
                <td><input type="number" step="0.01" min="0" class="form-control form-control-sm ing-cantidad" value="${cantidad}" required /></td>
                <td>
                    <select class="form-select form-select-sm ing-unidad">
                        ${['g','kg','ml','l','unidad','cda','cdta'].map(u =>
                            `<option value="${u}" ${u === unidad ? 'selected' : ''}>${u}</option>`).join('')}
                    </select>
                </td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()"><i class="bi bi-trash"></i></button></td>
            </tr>`;

        function agregarFilaIngrediente(nombre = '', cantidad = '', unidad = '') {
            document.getElementById('tablaIngredientes').insertAdjacentHTML('beforeend', rowTemplate(nombre, cantidad, unidad));
        }

        function limpiarModal() {
            document.getElementById('recetaId').value = '';
            document.getElementById('recetaNombre').value = '';
            document.getElementById('recetaDescripcion').value = '';
            document.getElementById('tablaIngredientes').innerHTML = '';
        }

        function abrirModalCrear() {
            limpiarModal();
            document.getElementById('tituloModalReceta').innerText = 'Nueva receta';
            agregarFilaIngrediente();
        }

        async function abrirModalEditar(id) {
            limpiarModal();
            document.getElementById('tituloModalReceta').innerText = 'Editar receta';

            const resp = await fetch(`?handler=Obtener&id=${id}`);
            if (!resp.ok) { alert('No se pudo cargar la receta.'); return; }
            const r = await resp.json();

            document.getElementById('recetaId').value = r.id;
            document.getElementById('recetaNombre').value = r.nombre;
            document.getElementById('recetaDescripcion').value = r.descripcion ?? '';
            r.ingredientes.forEach(i => agregarFilaIngrediente(i.nombre, i.cantidad, i.unidadMedida));
            if (r.ingredientes.length === 0) agregarFilaIngrediente();

            new bootstrap.Modal(document.getElementById('modalReceta')).show();
        }

        function leerIngredientes() {
            return [...document.querySelectorAll('#tablaIngredientes tr')].map(tr => ({
                nombre: tr.querySelector('.ing-nombre').value,
                cantidad: parseFloat(tr.querySelector('.ing-cantidad').value) || 0,
                unidadMedida: tr.querySelector('.ing-unidad').value
            })).filter(i => i.nombre.trim() !== '');
        }

        let guardando = false;

        async function guardarReceta() {
            if (guardando) return;
            guardando = true;

            const btnGuardar = document.querySelector('#modalReceta .btn-primary');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Guardando...';

            try{
                const id = document.getElementById('recetaId').value;
                const payload = {
                    nombre: document.getElementById('recetaNombre').value,
                    descripcion: document.getElementById('recetaDescripcion').value,
                    ingredientes: leerIngredientes()
                };

                if (!payload.nombre.trim()) { alert('El nombre es obligatorio.'); return; }

                const handler = id ? 'Actualizar' : 'Crear';
                if (id) payload.id = id;

                const resp = await fetch(`?handler=${handler}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiforgeryToken()
                    },
                    body: JSON.stringify(payload)
                });

                if (!resp.ok) {
                    const texto = await resp.text();
                    console.error('Error del servidor:', texto);
                    alert('No se pudo guardar la receta. Ver consola para detalle.');
                    return;
                }

                // Cerrar el modal explícitamente
                const modalEl = document.getElementById('modalReceta');
                bootstrap.Modal.getInstance(modalEl)?.hide();

                // Mostrar mensaje de éxito y recién ahí recargar
                mostrarToast(id ? 'Receta actualizada correctamente.' : 'Receta creada correctamente.');
                setTimeout(() => location.reload(), 900);
            }finally{
                guardando = false;
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = 'Guardar';
            }

        }

        function mostrarToast(mensaje) {
            const contenedor = document.getElementById('toastContainer') ?? (() => {
                const div = document.createElement('div');
                div.id = 'toastContainer';
                div.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                document.body.appendChild(div);
                return div;
            })();

            const toastId = 'toast-' + Date.now();
            contenedor.insertAdjacentHTML('beforeend', `
                <div id="${toastId}" class="toast align-items-center text-bg-success border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-check-circle"></i> ${mensaje}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `);
            new bootstrap.Toast(document.getElementById(toastId), { delay: 3000 }).show();
        }

        async function toggleActivo(id) {
            if (!confirm('¿Confirmar cambio de estado de la receta?')) return;
            const resp = await fetch(`?handler=Toggle`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getAntiforgeryToken()
                },
                body: `id=${id}`
            });
            if (!resp.ok) { alert('No se pudo actualizar el estado.'); return; }
            mostrarToast('Estado actualizado correctamente.');
            setTimeout(() => location.reload(), 900);
        }

        function getAntiforgeryToken() {
            return document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]').value;
        }
    </script>
}