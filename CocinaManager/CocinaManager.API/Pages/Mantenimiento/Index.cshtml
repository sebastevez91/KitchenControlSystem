@page
@model CocinaManager.API.Pages.Mantenimiento.IndexModel
@{
    ViewData["Title"] = "Mantenimiento";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-wrench-adjustable-circle-fill me-2"></i>Mantenimiento</h1>
        <p class="text-muted mb-0">Gestión de herramientas y órdenes de mantenimiento</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalNuevaOrden">
            <i class="bi bi-clipboard-plus me-1"></i> Nueva Orden
        </button>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevaHerramienta">
            <i class="bi bi-plus-lg me-1"></i> Nueva Herramienta
        </button>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card" style="background: linear-gradient(135deg, #667eea, #764ba2);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size:2rem; font-weight:700;">@Model.Herramientas.Count</div>
                    <div style="opacity:0.85;">Herramientas registradas</div>
                </div>
                <i class="bi bi-tools" style="font-size:2.5rem; opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background: linear-gradient(135deg, #f7971e, #ffd200);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size:2rem; font-weight:700;">
                        @Model.Herramientas.Count(h => h.Estado == EstadoHerramienta.EnReparacion)
                    </div>
                    <div style="opacity:0.85;">En reparación</div>
                </div>
                <i class="bi bi-wrench" style="font-size:2.5rem; opacity:0.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size:2rem; font-weight:700;">
                        @Model.Ordenes.Count(o => o.EstadoOrden == EstadoOrden.Pendiente)
                    </div>
                    <div style="opacity:0.85;">Órdenes pendientes</div>
                </div>
                <i class="bi bi-clipboard-x" style="font-size:2.5rem; opacity:0.4;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Tabla Herramientas -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-tools me-2"></i>Herramientas</span>
        <span class="badge bg-primary">@Model.Herramientas.Count herramientas</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Fecha Registro</th>
                        <th>Cambiar Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.Herramientas)
                    {
                        <tr>
                            <td class="fw-semibold">@h.Nombre</td>
                            <td class="text-muted">@h.Descripcion</td>
                            <td>
                                @{
                                    var estadoColor = h.Estado switch
                                    {
                                        EstadoHerramienta.Operativa => "success",
                                        EstadoHerramienta.EnReparacion => "warning",
                                        EstadoHerramienta.FueraDeServicio => "danger",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@estadoColor badge-estado">@h.Estado</span>
                            </td>
                            <td>@h.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>
                                <form method="post" asp-page-handler="CambiarEstadoHerramienta" class="d-flex gap-1">
                                    <input type="hidden" name="id" value="@h.Id" />
                                    <select name="estado" class="form-select form-select-sm" style="width:auto;">
                                        @foreach (var e in Enum.GetValues<EstadoHerramienta>())
                                        {
                                            <option value="@((int)e)" selected="@(e == h.Estado)">@e</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                            </td>
                            <td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form method="post" asp-page-handler="EliminarHerramienta"
                                          onsubmit="return confirm('¿Eliminar @h.Nombre?')">
                                        <input type="hidden" name="id" value="@h.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Tabla Órdenes -->
<div class="card">
    <div class="card-header">
        <i class="bi bi-clipboard-check me-2"></i>Órdenes de Mantenimiento
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Herramienta</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Fecha Creación</th>
                        <th>Fecha Resolución</th>
                        <th>Observaciones</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Ordenes.OrderByDescending(x => x.FechaCreacion))
                    {
                        <tr>
                            <td class="fw-semibold">@o.NombreHerramienta</td>
                            <td>@o.Descripcion</td>
                            <td>
                                @{
                                    var ordenColor = o.EstadoOrden switch
                                    {
                                        EstadoOrden.Pendiente => "warning",
                                        EstadoOrden.EnProceso => "info",
                                        EstadoOrden.Resuelta => "success",
                                        EstadoOrden.Cancelada => "secondary",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@ordenColor badge-estado">@o.EstadoOrden</span>
                            </td>
                            <td>@o.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td>@(o.FechaResolucion?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-muted">@(o.Observaciones ?? "-")</td>
                            <td>
                                @if (o.EstadoOrden == EstadoOrden.Pendiente || o.EstadoOrden == EstadoOrden.EnProceso)
                                {
                                    <div class="d-flex gap-1">
                                        <form method="post" asp-page-handler="ResolverOrden">
                                            <input type="hidden" name="id" value="@o.Id" />
                                            <input type="hidden" name="observaciones" value="Resuelta" />
                                            <button type="submit" class="btn btn-sm btn-success"
                                                    title="Resolver">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="CancelarOrden">
                                            <input type="hidden" name="id" value="@o.Id" />
                                            <input type="hidden" name="observaciones" value="Cancelada manualmente" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                    title="Cancelar">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nueva Herramienta -->
<div class="modal fade" id="modalNuevaHerramienta" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-tools me-2"></i>Nueva Herramienta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CrearHerramienta">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre</label>
                        <input asp-for="NuevaHerramienta.Nombre" class="form-control" placeholder="Ej: Cuchillo chef" />
                        <span asp-validation-for="NuevaHerramienta.Nombre" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción <span class="text-muted fw-normal">(opcional)</span></label>
                        <textarea asp-for="NuevaHerramienta.Descripcion" class="form-control" rows="3"
                                  placeholder="Descripción o detalle de la herramienta"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Nueva Orden -->
<div class="modal fade" id="modalNuevaOrden" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-clipboard-plus me-2"></i>Nueva Orden de Mantenimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CrearOrden">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Herramienta</label>
                        <select asp-for="NuevaOrden.HerramientaId" class="form-select">
                            <option value="">-- Seleccioná una herramienta --</option>
                            @foreach (var h in Model.Herramientas)
                            {
                                <option value="@h.Id">@h.Nombre (@h.Estado)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción del problema</label>
                        <textarea asp-for="NuevaOrden.Descripcion" class="form-control" rows="3"
                                  placeholder="Describí el problema o el trabajo a realizar"></textarea>
                        <span asp-validation-for="NuevaOrden.Descripcion" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear Orden</button>
                </div>
            </form>
        </div>
    </div>
</div>